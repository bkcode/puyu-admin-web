VITE_BASE=/

# 正式Gateway根origin；业务接口统一走 /admin-api/v1
VITE_GLOB_API_URL=https://api.zyyfdesign.top
# 普通密码登录与刷新直连自有Auth；客户端密钥只在Auth服务端
VITE_AUTH_API_URL=https://auth.zyyfdesign.top
VITE_PUYU_DATA_MODE=real

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
